          "name": "Retrieve Wadl Description for a Deployed Service",
          "request": {
            "name": "Retrieve Wadl Description for a Deployed Service",
            "description": {
              "content": "Returns the WADL (Web Application Description Language) document describing the available methods, parameters, and data types for the specified deployed REST service.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":serviceAlias"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "WADL",
                  "value": "<string>",
                  "description": "(Required) Flag to request the WADL description"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "serviceAlias",
                  "description": "(Required) The alias of the deployed REST service"
                },
                {
                  "description": "The Oracle EBS instance hostname",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
