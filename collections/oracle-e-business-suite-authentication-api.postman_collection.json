      "item": [
        {
          "id": "8fd41e33-2c40-4ecf-8864-a5a607979b38",
          "name": "Authenticate and Obtain Access Token",
          "request": {
            "name": "Authenticate and Obtain Access Token",
            "description": {
              "content": "Authenticates a user using HTTP Basic Authentication and returns a session access token for subsequent REST service calls. The access token is returned both as a cookie and in the response body.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The Oracle EBS instance hostname",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "NLS language context in RFC 5646 format. Controls the language for translated messages and data returned by the service.",
                "key": "Accept-Language",
                "value": "en-US"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "8c5aa814-f31d-40d6-95db-0fe3021b8d29",
              "name": "Successful authentication",
              "originalRequest": {
                "url": {
                  "path": [
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "The Oracle EBS instance hostname",
                      "type": "any",
                      "value": "{{instance}}",
                      "key": "instance"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "disabled": false,
                    "description": "NLS language context in RFC 5646 format. Controls the language for translated messages and data returned by the service.",
                    "key": "Accept-Language",
                    "value": "en-GB,en-US;q=0.8,en;q=0.6"
                  },
                  {
                    "disabled": false,
                    "description": "The format of the request body",
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "disabled": false,
                  "description": "Session access token cookie",
                  "key": "Set-Cookie",
                  "value": "string"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"response\": {\n    \"data\": {\n      \"accessToken\": \"example_value\",\n      \"accessTokenName\": \"example_value\",\n      \"ebsVersion\": \"example_value\",\n      \"userName\": \"example_value\"\n    }\n  }\n}",
              "cookie": [],
