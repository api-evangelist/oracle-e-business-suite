        {
          "id": "e0350258-2c3e-49d1-a840-a4f421f41735",
          "name": "Initialize Application Context",
          "request": {
            "name": "Initialize Application Context",
            "description": {
              "content": "Initializes the application context including responsibility, security group, and organization for the authenticated session. Must be called after login and before invoking any custom REST services.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "initialize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The Oracle EBS instance hostname",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "NLS language context in RFC 5646 format. Controls the language for translated messages and data returned by the service.",
                "key": "Accept-Language",
                "value": "en-US"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "accessToken"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"resp\": {\n      \"id\": \"<integer>\",\n      \"applId\": \"<integer>\",\n      \"key\": \"<string>\",\n      \"applKey\": \"<string>\"\n    },\n    \"securityGroup\": {\n      \"id\": \"<integer>\",\n      \"key\": \"<string>\"\n    },\n    \"org\": {\n      \"id\": \"<integer>\",\n      \"key\": \"<string>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
