              "value": "{{accessToken}}",
              "placement": "query"
            }
          },
          "docs": "Retrieves employee assignment records. Maps to the PER_ALL_ASSIGNMENTS_F table through the HR_ASSIGNMENT_API package."
        }
      ]
    },
