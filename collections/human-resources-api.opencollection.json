              {
                "name": "personId",
                "value": "500123",
                "type": "query",
                "description": "Person identifier"
              },
              {
                "name": "organizationId",
                "value": "500123",
                "type": "query",
                "description": "HR organization identifier"
              },
              {
                "name": "effectiveDate",
                "value": "2026-01-15",
                "type": "query",
                "description": "Effective date (YYYY-MM-DD)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return"
              },
              {
                "name": "offset",
                "value": "",
