          "name": "Invoke a Rest Service Method",
          "request": {
            "name": "Invoke a Rest Service Method",
            "description": {
              "content": "Invokes a specific method on a deployed REST service. The service alias and method name correspond to the PL/SQL API, Java Bean Service, Application Module Service, or other interface type deployed through the Integration Repository. Request and response payloads vary by service.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":serviceAlias",
                ":methodName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "serviceAlias",
                  "description": "(Required) The alias of the deployed REST service"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "methodName",
                  "description": "(Required) The REST method name to invoke"
                },
                {
                  "description": "The Oracle EBS instance hostname",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "NLS language context in RFC 5646 format. Controls the language for translated messages and data returned by the service.",
                "key": "Accept-Language",
                "value": "en-US"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "accessToken"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RESTHeader\": {\n    \"Responsibility\": \"<string>\",\n    \"RespApplication\": \"<string>\",\n    \"SecurityGroup\": \"<string>\",\n    \"NLSLanguage\": \"<string>\",\n    \"Org_Id\": \"<integer>\"\n  },\n  \"InputParameters\": {\n    \"key_0\": 2105\n  }\n}",
